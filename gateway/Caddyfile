{
	admin off
	auto_https disable_redirects
	email {$FOXOS_ACME_EMAIL}
	skip_install_trust
	servers {
		protocols h1 h2
	}
}

{$FOXOS_DOMAIN} {
	tls {
		dns cloudflare {env.CLOUDFLARE_API_TOKEN}
		resolvers 1.1.1.1
	}

	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		-Server
	}

	handle_path /_foxos/apps/foxos-adoption-lab/* {
		header X-FoxOS-Route "foxos-adoption-lab"
		reverse_proxy foxos-route-adoption-lab:80
	}

	handle {
		reverse_proxy foxos:8080
	}
}

https://127.0.0.1 {
	tls internal
	reverse_proxy foxos:8080
}
