# Safe default: access FoxOS through an SSH tunnel.
FOXOS_BIND_ADDRESS=127.0.0.1
FOXOS_PORT=8080

# Set to true only when FoxOS is served through HTTPS.
FOXOS_SECURE_COOKIE=false

# Trust exactly one reverse-proxy hop only when using the FoxOS gateway.
FOXOS_TRUST_PROXY=0

# Optional FoxOS-owned HTTPS gateway settings. The Cloudflare DNS token is not
# stored here; install-gateway.sh writes it to an owner-only Docker secret file.
FOXOS_DOMAIN=foxos.example.com
FOXOS_ACME_EMAIL=admin@example.com
FOXOS_HTTPS_BIND_ADDRESS=0.0.0.0
FOXOS_HTTPS_PORT=8443
